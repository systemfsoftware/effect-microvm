{
  "name": "@systemfsoftware/effect-daemon-microvm",
  "license": "Apache-2.0",
  "version": "1.0.3",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/effect-microvm.git",
    "directory": "packages/effect-daemon-microvm"
  },
  "homepage": "https://github.com/systemfsoftware/effect-microvm/tree/main/packages/effect-daemon-microvm#readme",
  "bugs": "https://github.com/systemfsoftware/effect-microvm/issues",
  "description": "MicroVM medium for effect-daemon-spec — workloads supervised inside hardware-isolated microVMs through @systemfsoftware/effect-microsandbox, with a conformance driver proving the medium against the fiber reference.",
  "keywords": [
    "effect",
    "effect-ts",
    "supervision",
    "supervisor",
    "daemon",
    "microvm",
    "microsandbox",
    "conformance"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "mutation": "stryker run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack .",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "^12.0.2",
    "@systemfsoftware/effect-daemon-conformance": "^1.0.2",
    "@systemfsoftware/effect-daemon-spec": "^6.0.2",
    "@systemfsoftware/effect-microsandbox": "workspace:^",
    "@systemfsoftware/effect-readiness": "^1.1.1"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/conformance-spec": "^1.0.1",
    "@systemfsoftware/effect-gherkin-spec": "^8.0.0",
    "@systemfsoftware/microvm-test-images": "workspace:^",
    "@systemfsoftware/oxlint-config-recommended": "^5.0.0",
    "@systemfsoftware/stryker-config": "^0.2.0",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/tsconfig": "^2.0.2",
    "@systemfsoftware/tsdown-config": "^0.1.1",
    "@systemfsoftware/vitest": "^3.0.0",
    "@systemfsoftware/vitest-config": "^0.1.1",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "microsandbox": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers",
    "typescript": ">=7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
